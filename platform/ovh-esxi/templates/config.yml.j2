---
# Generated by genconfig.yml from the bootstrap host. The gateway reuses this
# host's failover IP/MAC/gateway at handoff. Regenerate rather than hand-edit.
datastore: /vmfs/volumes/datastore1
portgroup: Internal
pub_portgroup: "VM Network"

vm_mem: 2048
vm_cpus: 1

# public side — captured from the bootstrap host's default-route NIC
ovh_mac: "{{ gen_ovh_mac }}"
pub_addr: "{{ gen_pub_addr }}"
pub_prefix: 32
pub_gw: "{{ gen_pub_gw }}"
pub_dns: 8.8.8.8

# random Internal /24 (from /dev/random) to avoid collisions
int_net: "{{ gen_int_net }}"
int_mac: "00:50:56:10:10:01"
